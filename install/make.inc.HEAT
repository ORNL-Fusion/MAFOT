#for cloning/building MAFOT inside docker container
# ---- Folder ----
MAFOT_DIR = /root/source/MAFOT
BIN_DIR = /root/source/MAFOT/build/bin
LIB_DIR = /root/source/MAFOT/build/lib

# ---- Support codes ----
# True or False
M3DC1 = True
# VMEC=True enables the XFIELD/XPAND 3-D field reader (response_field=-3); also links netCDF.
# No inline comment after the value: make keeps the whitespace and ifeq silently fails.
VMEC = True
SIESTA = False

# ---- Compiler ----
CXX = g++
CFLAGS = -O3 -fPIC
OMPFLAGS = -fopenmp -w

F90 = gfortran
F90FLAGS = -O3 -fPIC

# ---- Linker ----
ARCH = ar crus

LDD = g++ --shared
LDFLAGS =

# ---- Additional Defines ----
DEFS = -Dm3dc1_newfio

# ---- external Libraries ----
BLITZLIBS = -L/root/source/MAFOT/blitz++/blitz-0.9/lib -lblitz
FLIBS = -L/usr/lib/x86_64-linux-gnu -lgfortran
OMPLIBS = -L/usr/lib/x86_64-linux-gnu/openmpi/lib -lmpi
M3DC1LIBS = -L/root/source/M3DC1/build/lib -lfusionio -lm3dc1
HDF5LIBS = -L/usr/lib/x86_64-linux-gnu/hdf5/openmpi -lhdf5_cpp -lhdf5
NETCDFLIBS = -L/usr/lib/x86_64-linux-gnu -lnetcdf

# ---- external Includes ----
BLITZINCLUDE = -I/root/source/MAFOT/blitz++/blitz-0.9/blitz
OMPINCLUDE = -I/usr/lib/x86_64-linux-gnu/openmpi/include -I/usr/lib/x86_64-linux-gnu/openmpi/include/openmpi
M3DC1INCLUDE = -I/root/source/M3DC1/build/include
NETCDFINCLUDE = -I/usr/include

# ---- build GUI with python (optional) ----
#PYINSTALLER = /Library/Frameworks/EPD64.framework/Versions/7.2/bin/pyinstaller

# ---- GPU / CUDA support ----
# GPU=True compiles CUDA support into heatstructure / heatlaminar_mpi (one binary
# per tool). At runtime, -g uses the GPU and omitting -g runs the CPU path.
# cudart is linked statically (see GPU_LIBS in makefile), so the runtime image
# needs no CUDA libraries -- only the driver (libcuda.so, injected by --gpus)
# when -g is actually used. Requires nvcc from the CUDA Toolkit at CUDA_PATH.
#
# The binary runs only on GPUs it carries machine code (SASS) for, or whose
# architecture is newer than its embedded PTX: a single -arch=sm_XY build fails on
# any older GPU with "no kernel image is available for execution on the device".
# One -gencode per architecture the binary must run on, plus one PTX entry so a
# GPU newer than all of them can JIT-compile it:
#   sm_80 = Ampere data-center (A100)
#   sm_86 = Ampere consumer/cloud (RTX 30xx, A10/A10G -- AWS g5)
#   sm_89 = Ada (RTX 2000/40xx, L4 -- AWS g6, L40S -- AWS g6e)
#   sm_90 = Hopper (H100)
#   compute_90 = PTX for anything newer (Blackwell and beyond)
GPU = True
CUDA_PATH = /usr/local/cuda
NVCC = $(CUDA_PATH)/bin/nvcc
NVCCFLAGS = -O3 -std=c++14 \
            -gencode arch=compute_80,code=sm_80 \
            -gencode arch=compute_86,code=sm_86 \
            -gencode arch=compute_89,code=sm_89 \
            -gencode arch=compute_90,code=sm_90 \
            -gencode arch=compute_90,code=compute_90
